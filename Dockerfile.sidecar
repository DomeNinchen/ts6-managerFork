# syntax=docker/dockerfile:1.4
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY packages/sidecar/go.mod packages/sidecar/go.sum ./
RUN go mod download
COPY packages/sidecar/main.go packages/sidecar/prefetch_linux.go packages/sidecar/prefetch_other.go .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /sidecar .

# A modern static, self-contained ffmpeg build instead of bookworm's apt
# package (5.1), which is missing several codec/demuxer fixes present here.
FROM mwader/static-ffmpeg:7.1.1 AS ffmpeg

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=ffmpeg /ffmpeg /usr/local/bin/ffmpeg
COPY --from=build /sidecar /usr/local/bin/sidecar
EXPOSE 9800
CMD ["sidecar"]
